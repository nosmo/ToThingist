<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.nosmo.tothingist</string>

    <key>ProgramArguments</key>
    <array>
      <string>MYPATH/ToThingist/venv/bin/python3</string>
      <string>MYPATH/ToThingist/ToThingist.py</string>
      <string>-q</string>
   </array>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/tmp/tothingist_error.log</string>

    <key>StandardOutPath</key>
    <string>/tmp/tothingist_output.log</string>

</dict>
</plist>
